#!/usr/bin/env bash
# ChIPseq Pipeline — 升级到最新镜像/环境
set -euo pipefail

# shellcheck disable=SC1091
source "@@LIB@@"

DATA_DIR="$CHIPSEQ_DEFAULT_DATA_DIR"

# 先解析 -h/--help（不需读 runtime 即可给出用法）
case "${1:-}" in
    -h|--help)
        cat <<EOF
用法: chipseq-app-update [模式]

更新启动器环境（秒级）。可选模式同时处理分析环境 + R 包：
  all            推荐。先建分析环境（本地离线包 chipseq-env*.tar.gz 优先→秒级；否则在线 mamba/conda），
                 建完后自动调 install_R_packages.R 幂等补齐必需 R 包（已就位秒过）
  analysis       同 all
  online         仅在线 conda env create/update -p $CHIPSEQ_DEFAULT_ANALYSIS_ENV -f environment.yml + 补 R
  offline        仅从离线包解压安装分析环境 + 补 R
  （不带参数）   只更新启动器环境

当前项目内默认路径（封装到仓库，不写 HOME）：
  运行时目录: $CHIPSEQ_RUNTIME_DIR
  启动器:     $CHIPSEQ_DEFAULT_LAUNCH_ENV
  分析环境:   $CHIPSEQ_DEFAULT_ANALYSIS_ENV
  数据目录:   $CHIPSEQ_DEFAULT_DATA_DIR
  R 包库:     $CHIPSEQ_DEFAULT_RLIB
  conda 缓存: $CHIPSEQ_DEFAULT_PKGS

相关环境变量：
  CHIPSEQ_RUNTIME_DIR  项目内运行时目录（默认 <repo>/.chipseq-runtime）
  CHIPSEQ_DATA         数据目录（默认 <runtime>/data）
  CHIPSEQ_CONDA_ENV    分析 prefix（默认 <runtime>/analysis）
  CHIPSEQ_LAUNCH_ENV   启动器 prefix（默认 <runtime>/launch）
  CHIPSEQ_R_LIB        R 包库（默认 <runtime>/analysis/lib/R/library）
  CHIPSEQ_SKIP_R=1     跳过 R 包补齐步骤
  CHIPSEQ_R_ANNO=1     一并预装 TxDb/OrgDb 注释数据库
  CHIPSEQ_CRAN_MIRROR  自定义 CRAN 镜像
EOF
        exit 0 ;;
esac

RUNTIME=$(read_runtime "$DATA_DIR")

BACKEND="@@RUNTIME_DIR@@/${RUNTIME}.sh"
[ -f "$BACKEND" ] || die "找不到后端脚本 $BACKEND"
# shellcheck disable=SC1090
source "$BACKEND"

repo="${CHIPSEQ_REPO:-}"

# ---------- (1) 尽力拉取最新源码 ----------
# 以前 chipseq-app-update 完全不 pull，用户得自己 git pull，极易漏更；这里自动尝试，
# 失败（本地改动/网络/非 git 检出）不阻断，只用当前源码继续并提示手动 pull。
if [ -n "$repo" ] && git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log "拉取最新源码: $repo ..."
    if git -C "$repo" pull --ff-only; then
        ok "源码已更新"
    else
        warn "git pull 未成功（可能有本地改动或网络问题）；将用当前源码继续。可手动执行：git -C $repo pull"
    fi
else
    warn "未检测到 git 工作区，跳过拉取（请自行确认源码为最新）"
fi

# ---------- (2) 重装 CLI/后端/共享库到 .chipseq-runtime 执行副本 ----------
# 关键根因：chipseq-app 实际执行的是 .chipseq-runtime/{bin,lib,runtime} 里的安装副本，
# 而非仓库源文件；不重装则 git pull 下来的修复（streamlit 启动参数、访问横幅等）根本
# 不会生效——这正是「升级了却还白屏/还只印一个 IP」的元凶。
if [ -n "$repo" ] && [ -f "$repo/scripts/install-cli.sh" ]; then
    log "重装 CLI 执行副本 → 刷新 .chipseq-runtime/{bin,lib,runtime,assets} ..."
    bash "$repo/scripts/install-cli.sh" || warn "install-cli.sh 执行失败；执行副本可能未刷新，可手动重跑该脚本"
    # 重装后用最新副本重新加载共享库与后端。只重载 $BACKEND 不够：新增到
    # common.sh 的函数（如 seed_repo_config）在旧副本里不存在，会让新版后端
    # 报「未找到命令」——首次跨版本升级必踩。
    # shellcheck disable=SC1091
    source "@@LIB@@" 2>/dev/null || true
    # shellcheck disable=SC1090
    source "$BACKEND" 2>/dev/null || true
else
    warn "找不到 $repo/scripts/install-cli.sh；执行副本未刷新（请手动运行 scripts/install-cli.sh）"
fi

# ---------- (3) 重建环境 ----------
log "升级中 (runtime=$RUNTIME) ..."
runtime_update "$@"
ok "升级完成；再次运行 'chipseq-app' 启动新版本"
