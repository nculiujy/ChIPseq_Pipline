#!/usr/bin/env bash
# ChIPseq Pipeline — 升级到最新镜像/环境
set -euo pipefail

# shellcheck disable=SC1091
source "@@LIB@@"

DATA_DIR="${CHIPSEQ_DATA:-$HOME/.chipseq-pipeline}"

# 先解析 -h/--help（不需读 runtime 即可给出用法）
case "${1:-}" in
    -h|--help)
        cat <<EOF
用法: chipseq-app-update [模式]

更新启动器环境（秒级）。可选模式同时处理分析环境 + R 包：
  all            推荐。先建分析环境（本地离线包 chipseq-env*.tar.gz 优先→秒级；否则在线 mamba/conda），
                 建完后自动调 install_R_packages.R 幂等补齐必需 R 包（已就位秒过）
  analysis       同 all
  online         仅在线 conda env create/update -p ~/.local/chipseq-env -f environment.yml + 补 R
  offline        仅从离线包解压安装分析环境 + 补 R
  （不带参数）   只更新启动器环境
相关环境变量：
  CHIPSEQ_SKIP_R=1     跳过 R 包补齐步骤
  CHIPSEQ_R_ANNO=1     一并预装 TxDb/OrgDb 注释数据库
  CHIPSEQ_CRAN_MIRROR  自定义 CRAN 镜像
EOF
        exit 0 ;;
esac

RUNTIME=$(read_runtime "$DATA_DIR")

BACKEND="@@RUNTIME_DIR@@/${RUNTIME}.sh"
# shellcheck disable=SC1090
source "$BACKEND"

log "升级中 (runtime=$RUNTIME) ..."
runtime_update "$@"
ok "升级完成；再次运行 'chipseq-app' 启动新版本"
