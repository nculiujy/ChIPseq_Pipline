#!/usr/bin/env bash
# ChIPseq Pipeline — 卸载本项目安装的所有组件
#
# 默认删除（保留用户数据）：
#   - <repo>/.chipseq-runtime/ 除 data/ 之外的所有子目录
#       launch/  analysis/  pkgs/  Rlib/  cache/  bin/  lib/  runtime/  assets/
#   - ~/.local/bin/chipseq-app*    软链接（或旧版真实文件）
#   - ~/.conda/environments.txt 中属于本项目的行
#
# 保留：
#   - <repo>/.chipseq-runtime/data/     （配置 / 参考基因组 / 结果 / 日志）
#
# 选项：
#   --data             连项目内数据目录一起删（不可逆！）
#   --purge-legacy     一并删旧版本 HOME 侧残留：~/.local/chipseq-{env,launch}、
#                      ~/.chipseq-pipeline、~/.local/share/chipseq-pipeline
#   --all              = --data + --purge-legacy（彻底清空本机所有 chipseq 相关）
#   -y, --yes          跳过交互确认
#   -h, --help         用法
#
# 环境变量（覆盖默认 prefix）：
#   CHIPSEQ_RUNTIME_DIR  项目内运行时目录（默认 <repo>/.chipseq-runtime）
#   CHIPSEQ_DATA         数据目录（默认 <runtime>/data）
#   CHIPSEQ_LAUNCH_ENV   启动器 prefix（默认 <runtime>/launch）
#   CHIPSEQ_CONDA_ENV    分析 prefix （默认 <runtime>/analysis）
#   PREFIX               HOME 侧软链前缀（默认 ~/.local）
set -euo pipefail

# shellcheck disable=SC1091
source "@@LIB@@"

# 派生：CHIPSEQ_REPO / CHIPSEQ_RUNTIME_DIR 已在 common.sh 顶部计算
_install_root="${PREFIX:-$HOME/.local}"
BIN_DIR="$_install_root/bin"
RUNTIME_DIR="$CHIPSEQ_RUNTIME_DIR"
DATA_DIR="$CHIPSEQ_DEFAULT_DATA_DIR"
LAUNCH_ENV="$CHIPSEQ_DEFAULT_LAUNCH_ENV"
ANALYSIS_ENV="$CHIPSEQ_DEFAULT_ANALYSIS_ENV"

# 旧版本可能落 HOME 的位置（仅 --purge-legacy/--all 才动）
LEGACY_TARGETS=(
    "$HOME/.local/chipseq-launch"
    "$HOME/.local/chipseq-env"
    "$HOME/.chipseq-pipeline"
    "$_install_root/share/chipseq-pipeline"
)

usage() {
    cat <<EOF
用法: chipseq-app-uninstall [选项]

卸载本项目安装的所有组件。默认保留 <runtime>/data（参考基因组/结果/配置）。

项目位置：
  仓库:         ${CHIPSEQ_REPO:-<未派生，请设 CHIPSEQ_REPO>}
  运行时目录:   $RUNTIME_DIR
  数据目录:     $DATA_DIR

选项:
  --data            连项目内数据目录一起删（不可逆！）
  --purge-legacy    一并删旧版本 HOME 侧残留（~/.local/chipseq-*、~/.chipseq-pipeline、~/.local/share/chipseq-pipeline）
  --all             = --data + --purge-legacy（彻底清空）
  -y, --yes         跳过交互确认
  -h, --help        显示本帮助
EOF
}

RM_DATA=0
PURGE_LEGACY=0
ASSUME_YES=0
while [ $# -gt 0 ]; do
    case "$1" in
        --data)         RM_DATA=1 ;;
        --purge-legacy) PURGE_LEGACY=1 ;;
        --all)          RM_DATA=1; PURGE_LEGACY=1 ;;
        -y|--yes)       ASSUME_YES=1 ;;
        -h|--help)      usage; exit 0 ;;
        *)              die "未知选项 '$1'（-h 看用法）" ;;
    esac
    shift
done

# ---------- 安全校验 ----------
_is_safe_target() {
    local p="$1"
    [ -n "$p" ] || return 1
    case "$p" in
        /|"$HOME"|/home|/root|/usr|/etc|/var|/bin|/sbin|/lib|/lib64|/opt|/mnt|/media) return 1 ;;
    esac
    local base="${p##*/}"
    [ -n "$base" ] && [ "$base" != "." ] && [ "$base" != ".." ] || return 1
    return 0
}

# ---------- 收集要删的目标 ----------
_targets=()

# .chipseq-runtime 下的子目录：默认保留 data/，其他全删
if [ -d "$RUNTIME_DIR" ]; then
    for sub in "$RUNTIME_DIR"/* "$RUNTIME_DIR"/.[!.]* ; do
        [ -e "$sub" ] || continue
        base="${sub##*/}"
        if [ "$base" = "data" ] && [ "$RM_DATA" != 1 ]; then
            continue  # 保留数据
        fi
        _targets+=("$sub")
    done
fi

# ~/.local/bin/chipseq-app* 软链或真实文件（永远删）
for f in "$BIN_DIR"/chipseq-app*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    _targets+=("$f")
done

# 旧 HOME 侧残留：仅 --purge-legacy/--all
if [ "$PURGE_LEGACY" = 1 ]; then
    for p in "${LEGACY_TARGETS[@]}"; do
        [ -e "$p" ] && _targets+=("$p")
    done
fi

# 单独提示（--data 时 data 会作为一个 target 被加入）
if [ "$RM_DATA" = 1 ] && [ -d "$RUNTIME_DIR/data" ]; then
    _targets+=("$RUNTIME_DIR/data")
fi

# ---------- 展示 ----------
log "==== ChIPseq Pipeline 卸载 ===="
log "仓库:         ${CHIPSEQ_REPO:-<未知>}"
log "运行时目录:   $RUNTIME_DIR"
if [ "$RM_DATA" = 1 ]; then
    warn "数据目录:     $DATA_DIR  ← 也将删除（参考基因组/结果/配置，不可逆！）"
else
    log "数据目录:     $DATA_DIR  ← 保留（如需删除加 --data）"
fi
[ "$PURGE_LEGACY" = 1 ] && log "同时清理旧 HOME 侧残留"

if [ "${#_targets[@]}" -eq 0 ]; then
    ok "没有检测到已安装的组件，无需卸载。"
    exit 0
fi

echo
log "将要删除以下 ${#_targets[@]} 项："
for t in "${_targets[@]}"; do
    sz=""
    if command -v du >/dev/null 2>&1; then sz="  ($(du -sh "$t" 2>/dev/null | awk '{print $1}'))"; fi
    printf '  - %s%s\n' "$t" "$sz"
done
echo

if [ "$ASSUME_YES" != 1 ]; then
    ans="n"
    printf '确认卸载？输入 yes 继续，其它任意键取消: '
    read -r ans || ans="n"
    [ "$ans" = "yes" ] || { log "已取消，未做任何改动。"; exit 0; }
fi

# ---------- 先优雅停止服务 ----------
if command -v chipseq-app-stop >/dev/null 2>&1; then
    chipseq-app-stop >/dev/null 2>&1 || true
fi
[ -f "$DATA_DIR/streamlit.pid" ] && kill -TERM "$(cat "$DATA_DIR/streamlit.pid")" 2>/dev/null || true

# ---------- 用 conda 卸载 prefix env（幂等 + 顺带清 environments.txt），失败回落 rm ----------
_remove_prefix_env() {
    local p="$1"
    _is_safe_target "$p" || return 1
    [ -d "$p/conda-meta" ] || return 1
    local c=""
    if command -v conda >/dev/null 2>&1; then c=conda
    elif command -v mamba >/dev/null 2>&1; then c=mamba
    fi
    if [ -n "$c" ]; then
        log "conda env remove: $p"
        "$c" env remove -p "$p" -y >/dev/null 2>&1 || true
    fi
    [ -d "$p" ] && rm -rf "$p"
    return 0
}

# ---------- 逐项删除 ----------
for t in "${_targets[@]}"; do
    if [ -L "$t" ] && [ ! -e "$t" ]; then
        # 悬空软链：直接 unlink（rm 亦可）
        _is_safe_target "$t" || { warn "跳过不安全路径: $t"; continue; }
        log "移除悬空软链: $t"; rm -f "$t"; continue
    fi
    if [ -L "$t" ]; then
        _is_safe_target "$t" || { warn "跳过不安全路径: $t"; continue; }
        log "移除软链: $t → $(readlink "$t" 2>/dev/null || echo '?')"; rm -f "$t"; continue
    fi
    _is_safe_target "$t" || { warn "跳过不安全路径: '$t'"; continue; }
    [ -e "$t" ] || continue
    if ! _remove_prefix_env "$t"; then
        log "删除: $t"
        rm -rf "$t"
    fi
done

# ---------- 清 conda environments.txt 中属于本项目 / 旧位置的行 ----------
_clean_env_txt() {
    local f="$HOME/.conda/environments.txt"
    [ -f "$f" ] || return 0
    local prefixes=()
    [ -n "${CHIPSEQ_RUNTIME_DIR:-}" ] && prefixes+=("$CHIPSEQ_RUNTIME_DIR")
    [ -n "${RUNTIME_DIR:-}" ] && [ "$RUNTIME_DIR" != "${CHIPSEQ_RUNTIME_DIR:-}" ] && prefixes+=("$RUNTIME_DIR")
    if [ "$PURGE_LEGACY" = 1 ]; then
        prefixes+=("$HOME/.local/chipseq-launch" "$HOME/.local/chipseq-env")
    fi
    local p cleaned=0
    for p in "${prefixes[@]:-}"; do
        [ -n "$p" ] || continue
        local tmp="$f.tmp.$$"
        # 前缀匹配则丢弃（index==1），其余原样保留
        if awk -v p="$p" 'index($0,p)==1{next}{print}' "$f" > "$tmp" 2>/dev/null; then
            if cmp -s "$tmp" "$f"; then
                rm -f "$tmp"
            else
                mv "$tmp" "$f"; cleaned=1
            fi
        else
            rm -f "$tmp"
        fi
    done
    [ "$cleaned" = 1 ] && log "已清 ~/.conda/environments.txt 中本项目行"
}
_clean_env_txt || true

# ---------- 收尾提示 ----------
echo
if [ "$RM_DATA" = 1 ]; then
    ok "卸载完成，含项目内数据目录已清除。"
else
    ok "卸载完成。数据目录 $DATA_DIR 已保留（参考基因组/结果/配置未动）。"
    log "如需连数据一起清空：chipseq-app-uninstall --data"
fi
if [ "$PURGE_LEGACY" = 0 ]; then
    _remaining_legacy=()
    for p in "${LEGACY_TARGETS[@]}"; do
        [ -e "$p" ] && _remaining_legacy+=("  - $p")
    done
    if [ ${#_remaining_legacy[@]} -gt 0 ]; then
        log "检测到旧版本 HOME 侧残留，可用 --purge-legacy 一并删："
        printf '%s\n' "${_remaining_legacy[@]}"
    fi
fi
log "重新安装：cd <仓库目录> && CHIPSEQ_RUNTIME=conda ./bootstrap.sh"
log "注意：本条命令自身（chipseq-app-uninstall）也已随之移除；从仓库 cli/ 重新 bootstrap 才会再出现。"

