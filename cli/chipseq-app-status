#!/usr/bin/env bash
# ChIPseq Pipeline — 状态查询
set -euo pipefail

# shellcheck disable=SC1091
source "@@LIB@@"

DATA_DIR="${CHIPSEQ_DATA:-$HOME/.chipseq-pipeline}"
RUNTIME=$(read_runtime "$DATA_DIR")

BACKEND="@@RUNTIME_DIR@@/${RUNTIME}.sh"
# shellcheck disable=SC1090
source "$BACKEND"

echo "============================================================"
echo " ChIPseq Pipeline 状态"
echo "------------------------------------------------------------"
echo "数据目录:    $DATA_DIR"
runtime_status
echo "============================================================"
