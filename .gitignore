# 参考文件（不上传）
参考_README.md

# 测序原始数据（文件体积过大，不上传）
workflow/resources/TAIR10/*
!workflow/resources/TAIR10/.gitkeep
workflow/resources/homo/*
!workflow/resources/homo/.gitkeep
workflow/anno/TAIR10_chr_all.fas
workflow/anno/Bowtie2anno_TAIR10/*
!workflow/anno/Bowtie2anno_TAIR10/.gitkeep
workflow/anno/Bowtie2anno_TAIR10_arabidopsis/*
!workflow/anno/Bowtie2anno_TAIR10_arabidopsis/.gitkeep
workflow/anno/Bowtie2anno_GRCh38/*
!workflow/anno/Bowtie2anno_GRCh38/.gitkeep

# ---------- 由 UI（🧬 物种注释页）下载 / 本地构建的注释文件（体积大，不入 git）----------
# 物种目录下的内容一律按需下载（序列、索引、说明文件），只保留目录自身的 README.md
workflow/anno/*/
!workflow/anno/*/README.md
# bowtie2 索引目录（任意物种下的 bowtie2_index_*/）
workflow/anno/*/bowtie2_index*/
# 基因组 / 注释 / faidx 等常见大文件（任意层级）；.gz 已在下面全局忽略
workflow/anno/**/*.fa
workflow/anno/**/*.fasta
workflow/anno/**/*.fna
workflow/anno/**/*.fai
workflow/anno/**/*.bt2
workflow/anno/**/*.gff
workflow/anno/**/*.gff3
workflow/anno/**/*.gtf
workflow/anno/**/*.2bit
# 物种注释下载任务的运行时状态与断点续传中间文件
workflow/anno/tasks/
workflow/anno/*/*.part
workflow/anno/*/*.download
# Glycine_max_v4 目录只保留 README
workflow/anno/Glycine_max_v4/*
!workflow/anno/Glycine_max_v4/README.md

# ---------- 用户自己的项目配置 ----------
# 首次启动时由 assets/ 下的模板生成，每个人的 config 都带本机路径与自己的样本，不入库。
config/*
!config/.gitkeep

# 分析结果（可重新生成）
result/*
!result/.gitkeep

# 日志文件
logs/*
!logs/.gitkeep

# Snakemake 缓存
.snakemake/

# 项目内封装的运行时目录（启动器/分析 env、conda 包缓存、R 库、pip 缓存、数据、日志）
# 一个 'rm -rf .chipseq-runtime' = 卸载整个应用（包括数据）；详见 README【目录位置】
.chipseq-runtime/

# Benchmarks
benchmarks/*
!benchmarks/.gitkeep

# IDE 配置
.trae/
.vscode/
*.idea/

# 系统文件
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/
*.pyc
*.pyo

# R 临时文件
*.Rhistory
*.RData
*.Rproj.user/

# 压缩包
*.zip
*.tar.gz
*.gz

# 临时文件
*.tmp
*.bak
*.swp

# Streamlit 缓存
streamlit_app/__pycache__/
streamlit_app/.streamlit/secrets.toml

# ---------- 部署产物（由 container/build*.sh 生成，不入 git） ----------
# Apptainer .sif
*.sif
chipseq-pipeline.sif

# conda-pack 环境包
chipseq-env-*.tar.gz

# OCI 镜像离线包
chipseq-pipeline-image.tar
chipseq-pipeline-image.tar.zst

# 用户数据目录（默认在 ~/.chipseq-pipeline，仅防误建到仓库内）
.chipseq-pipeline/

# 本地文档集合（收拢，不上传 GitHub）
_local_docs/
